{
  "manifest_version": 3,
  "name": "AmooPrep \u2014 Adaptive Study Companion",
  "version": "0.4.0",
  "description": "AmooPrep multi-course adaptive study companion with practice questions, flashcards, mock exams, mastery tracking, and optional premium course packs.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.lemonsqueezy.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open AmooPrep",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
